@* רכיב משותף: כרטיס תצוגה לדפים הפנימיים - מיועד להצגת נתון או פעולה למשתמשים ולמנהלים לפי הרשאתם *@

<div class="card card-soft-pink border-0 shadow-sm h-100">
    <div class="card-body d-flex flex-column justify-content-between p-4">
        <div>
            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <h2 class="h6 fw-bold mb-0" style="color: #4a3e4e;">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(BadgeText))
                {
                    <span class="role-pill">@BadgeText</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Value))
            {
                <div class="stat-value my-2">@Value</div>
            }

            <p class="text-secondary small mb-3">@Description</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(ActionText) && !string.IsNullOrWhiteSpace(ActionHref))
        {
            <div>
                <a href="@ActionHref" class="btn btn-primary btn-sm text-dark fw-semibold w-100">
                    @ActionText
                </a>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Value { get; set; }
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public string? ActionHref { get; set; }
}