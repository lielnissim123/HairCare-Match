@using View.Components.Shared
@inherits LayoutComponentBase
@implements IDisposable
@inject UserSession Session
@inject NavigationManager Navigation
@using View.Services


<div class="page" dir="rtl">
    <!-- סרגל עליון צמוד למעלה -->
    <header class="navbar navbar-expand-sm navbar-light border-bottom px-4 py-3 sticky-top" style="background-color: #fff5f7;">
        <div class="container-fluid">
            <!-- הלוגו המשותף שלנו -->
            <Logo />

            <nav class="d-flex gap-2 align-items-center">
                @* נוסף בגרסה 6: אם יש משתמש מחובר, מציגים ברכה עם שם המשתמש שלו וכפתור יציאה.
               אחרת מציגים "שלום, אורח" ואת שני הכפתורים לכניסה ולהרשמה *@
                @if (Session.IsLoggedIn)
                {
                    <span class="fw-semibold">שלום, @Session.Username</span>
                    <button class="btn btn-outline-primary" type="button" @onclick="Logout">יציאה</button>
                }
                else
                {
                    @* גולש שלא נכנס לחשבון מקבל ברכה כללית *@
                    <span class="fw-semibold">שלום, אורח</span>
                    <a class="btn btn-outline-primary" href="login">כניסה</a>
                    <a class="btn btn-primary" href="register">הרשמה</a>
                }
            </nav>
        </div>
    </header>

    <!-- תוכן הדפים השונים יופיע כאן אוטומטית -->
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged; // לאירוע נרשמים
    }
    private void OnSessionChanged()
    {
        InvokeAsync(StateHasChanged); // הסרגל את מעדכנים
    }
    private void Logout()
    {
        Session.Logout();
        Navigation.NavigateTo("");
    }
    public void Dispose()
    {
        Session.OnChange -= OnSessionChanged; // ההרשמה את מבטלים
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Session.LoadFromStorageAsync();
        }
    }
}
