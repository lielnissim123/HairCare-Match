    // protected override void OnInitialized()
    // {
    //     אם אין משתמש מחובר, מעבירים לדף הכניסה
    //     if (!Session.IsLoggedIn)
    //     {
    //         Navigation.NavigateTo("/login");
    //         return;
    //     }

    //     אם המשתמש מחובר אבל התפקיד אינו ContentManager, מעבירים לדף אין הרשאה
    //     if (Session.RoleName != "ContentManager")
    //     {
    //         Navigation.NavigateTo("/unauthorized");
    //         return;
    //     }
    // }

    // הוספה בתוך @code של הדף המוגן:
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Session.LoadFromStorageAsync(); // הוספה: שחזור משתמש אחרי ריענון/הקלדת כתובת

            if (!Session.IsLoggedIn)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (Session.RoleName != "ContentManager") 
            {
                Navigation.NavigateTo("/unauthorized");
                return;
            }

            StateHasChanged(); // הוספה: הצגת התוכן לאחר טעינת המשתמש
        }
    }
}