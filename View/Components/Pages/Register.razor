@page "/register"
@inject NavigationManager Navigation
@using View.Components.Shared

<PageTitle>הרשמה · HairCare Match</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="card card-soft-pink p-4 p-md-5 shadow-sm border-0">
                <div class="card-body p-0">
                    <h1 class="h2 fw-bold mb-2" style="color: #4a3e4e;">הרשמה ל-<span style="color: #e879f9;">HairCare Match</span></h1>
                    <p class="text-secondary mb-4">צרי חשבון חדש והתחילי את המסע שלך 🌸</p>

                    <form novalidate>
                        <!-- שדות הטופס באמצעות Field -->
                        <Field Id="reg-fullname" Label="שם מלא" Name="fullname" @bind-Value="fullName" />
                        <Field Id="reg-email" Label="כתובת אימייל" Name="email" Type="email" Dir="ltr" @bind-Value="email" />
                        <Field Id="reg-password" Label="סיסמה" Name="password" Type="password" Dir="ltr" @bind-Value="password" />

                        <!-- הודעת שגיאה -->
                        @if (errorMessage != null)
                        {
                            <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
                        }

                        <!-- כפתור הרשמה -->
                        <button class="btn btn-primary btn-lg w-100 mt-3 text-dark fw-semibold" type="button"
                                disabled="@isBusy" @onclick="RegisterAsync">
                            @if (isBusy)
                            {
                                <span>נרשמות...</span>
                            }
                            else
                            {
                                <span>הרשמי עכשיו</span>
                            }
                        </button>
                    </form>
                </div>
            </div>

            <p class="text-center mt-4">
                כבר יש לך חשבון? <a class="fw-bold text-decoration-none" href="login" style="color: #e879f9;">התחברי כאן</a>
            </p>

        </div>
    </div>
</div>

@code {
    private string? fullName;
    private string? email;
    private string? password;
    private string? errorMessage;
    private bool isBusy;

    private async Task RegisterAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "יש למלא את כל השדות.";
            return;
        }

        isBusy = true;
        await Task.Delay(800);
        isBusy = false;

        Navigation.NavigateTo("login");
    }
}