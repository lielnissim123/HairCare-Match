@page "/contentmanager-home"
@using View.Services
@inject UserSession Session
@inject NavigationManager Navigation

@* מציגים את התוכן רק אם המשתמש מחובר והוא ContentManager *@
@if (Session.IsLoggedIn && Session.RoleName == "ContentManager")
{
    <h3>ניהול תוכן - מנהל תוכן (ContentManager)</h3>
    <p>ברוך הבא לניהול התוכן. מכאן ניתן להוסיף, לערוך ולאשר טיפולים וביקורות[cite: 3].</p>
}

@code {
