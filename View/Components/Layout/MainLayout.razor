@using View.Components.Shared
@inherits LayoutComponentBase

<div class="page" dir="rtl">
    <!-- סרגל עליון צמוד למעלה -->
    <header class="navbar navbar-expand-sm navbar-light border-bottom px-4 py-3 sticky-top" style="background-color: #fff5f7;">
        <div class="container-fluid">
            <!-- הלוגו המשותף שלנו -->
            <Logo />

            <!-- קישורי הניווט -->
            <nav class="nav gap-3 align-items-center">
                <NavLink class="nav-link fw-semibold" href="" Match="NavLinkMatch.All" style="color: #4a3e4e;">דף הבית</NavLink>
                <NavLink class="nav-link fw-semibold" href="login" style="color: #4a3e4e;">התחברות</NavLink>
                <NavLink class="nav-link btn btn-primary px-3 text-dark fw-semibold" href="register">הרשמה</NavLink>
            </nav>
        </div>
    </header>

    <!-- תוכן הדפים השונים יופיע כאן אוטומטית -->
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
