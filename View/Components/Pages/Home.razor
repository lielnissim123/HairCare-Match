@page "/"

<PageTitle>דף הבית · HairCare Match</PageTitle>

<!-- אזור 1: פתיחה (Hero Section) -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- עמודת הטקסט -->
            <div class="col-lg-7">
                <span class="badge bg-light text-dark mb-3 px-3 py-2 rounded-pill fw-semibold border">התאמת שגרת טיפוח אישית 🌸</span>
                <h1 class="display-4 fw-bold mb-3" style="color: #4a3e4e;">
                    מוצאות את ההתאמה המושלמת ל<span style="color: #e879f9;">שיער שלך</span>
                </h1>
                <p class="lead text-secondary mb-4">
                    גלי איזה מוצרים, רכיבים ושגרת טיפוח באמת מתאימים לסוג השיער שלך. בלי ניחושים, מבוסס על נתונים אמיתיים.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="register" class="btn btn-primary btn-lg px-4 fw-semibold text-dark">התחילי עכשיו</a>
                    <a href="login" class="btn btn-outline-primary btn-lg px-4 fw-semibold" style="color: #4a3e4e; border-color: #e879f9;">התחברות</a>
                </div>
            </div>

            <!-- עמודת האיור / התמונה -->
            <div class="col-lg-5">
                <div class="card card-soft-pink border-0 shadow-sm p-4 text-center">
                    <div class="py-5">
                        <span class="display-1">✨ 🧴 💖</span>
                        <h3 class="h4 fw-bold mt-3" style="color: #4a3e4e;">HairCare Match</h3>
                        <p class="text-secondary small">המדריך האישי שלך לשיער בריא ומלא ברק</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- אזור 2: למה זה חשוב -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold" style="color: #4a3e4e;">למה טיפוח מדויק חשוב?</h2>
            <p class="text-secondary">כדי שהשיער שלך יקבל בדיוק את מה שהוא צריך</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 card-soft-pink">
                    <div class="h3 mb-3">💧</div>
                    <h4 class="h5 fw-bold" style="color: #4a3e4e;">התאמה לסוג השיער</h4>
                    <p class="text-secondary mb-0">לכל סוג שיער (מתולתל, חלק, יבש או צבוע) מגיעה שגרה ייחודית משלו.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 card-soft-pink">
                    <div class="h3 mb-3">🧪</div>
                    <h4 class="h5 fw-bold" style="color: #4a3e4e;">הבנת רכיבים</h4>
                    <p class="text-secondary mb-0">למדי אילו חומרים פעילים עוזרים לשקם את השיער ואילו כדאי להفחית.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4 card-soft-pink">
                    <div class="h3 mb-3">💡</div>
                    <h4 class="h5 fw-bold" style="color: #4a3e4e;">תוצאות לאורך זמן</h4>
                    <p class="text-secondary mb-0">מעקב חכם שמוביל לשיפור אמיתי במראה ובבריאות השיער.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- אזור 3: הזמנה להצטרף (Call to action) -->
<section class="py-5 text-white text-center" style="background-color: #4a3e4e;">
    <div class="container py-4">
        <h2 class="fw-bold mb-3">מוכנות לגלות את שגרת הטיפוח שלך?</h2>
        <p class="lead opacity-75 mb-4">הצטרפי אלינו עכשיו וצרי את החשבון שלך בקלות.</p>
        <a href="register" class="btn btn-lg px-5 fw-semibold" style="background-color: #e879f9; color: #4a3e4e;">הירשמי עכשיו</a>
    </div>
</section>